<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/card_dark"
    app:cardCornerRadius="18dp"
    app:cardElevation="4dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1.2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header: Icon + Title + Badges + Favorite Star -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Emoji Icon Circle -->
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/icon_circle_background">

                <TextView
                    android:id="@+id/tvModEmoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="🔮"
                    android:textSize="24sp" />
            </FrameLayout>

            <!-- Title & Badges Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvModTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="1.5dp"
                    android:maxLines="2"
                    android:text="MYTHOS: ASCENSION RPG"
                    android:textColor="@color/text_white"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />

                <!-- Badges Row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Category / Feature Badge -->
                    <TextView
                        android:id="@+id/tvModBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:background="@drawable/badge_category_background"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="MYTHOS ASCENSION"
                        android:textColor="#F0ABFC"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <!-- File Size Badge -->
                    <TextView
                        android:id="@+id/tvModSize"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/badge_size_background"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:paddingStart="7dp"
                        android:paddingEnd="7dp"
                        android:text="💾 12.4 MB"
                        android:textColor="#CBD5E1"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <!-- 60 FPS Locked Badge -->
                    <TextView
                        android:id="@+id/tvModFps"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/badge_size_background"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:paddingStart="7dp"
                        android:paddingEnd="7dp"
                        android:text="⚡ 60 FPS"
                        android:textColor="@color/omnitrix_glow"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <!-- Favorite Star Button -->
            <TextView
                android:id="@+id/btnFavorite"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/badge_size_background"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="☆"
                android:textColor="#FDE047"
                android:textSize="20sp" />

        </LinearLayout>

        <!-- Description -->
        <TextView
            android:id="@+id/tvModDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.25"
            android:maxLines="4"
            android:text="Masterpiece RPG experience! 6 Ascendant Classes, Mana &amp; Spell-casting, Omega Fortress Dungeons, and Mythic World Bosses!"
            android:textColor="@color/text_gray"
            android:textSize="12.5sp" />

        <!-- Card Progress Bar (Visible during import) -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/cardProgress"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="10dp"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/omnitrix_green"
            app:trackColor="@color/surface_dark" />

        <!-- Action Row: Guide + Import (Pixel-Perfect 46dp Height Alignment) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnModDetails"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:android:insetTop="0dp"
                android:android:insetBottom="0dp"
                android:android:insetLeft="0dp"
                android:android:insetRight="0dp"
                android:background="@drawable/btn_mod_guide_outline"
                android:elevation="2dp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="📖 Guide"
                android:textColor="@color/omnitrix_glow"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnImportMod"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:android:insetTop="0dp"
                android:android:insetBottom="0dp"
                android:android:insetLeft="0dp"
                android:android:insetRight="0dp"
                android:background="@drawable/btn_mythos_arcane"
                android:elevation="4dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:text="🔮 IMPORT MYTHOS ASCENSION 🔮"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
