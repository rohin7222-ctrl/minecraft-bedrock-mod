<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/card_dark"
    app:cardCornerRadius="18dp"
    app:cardElevation="5dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1.2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header: Icon + Title + Badges -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Emoji Icon Circle -->
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/icon_circle_background">

                <TextView
                    android:id="@+id/tvModEmoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="🏛️"
                    android:textSize="24sp" />
            </FrameLayout>

            <!-- Title & Badges Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvModTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CIVILIZATION: AUTONOMOUS AI"
                    android:textColor="@color/text_white"
                    android:textSize="16.5sp"
                    android:textStyle="bold" />

                <!-- Badges Row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Category / Feature Badge -->
                    <TextView
                        android:id="@+id/tvModBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#064E3B"
                        android:paddingStart="8dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="2dp"
                        android:text="CIVILIZATION AI"
                        android:textColor="#6EE7B7"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <!-- File Size Badge -->
                    <TextView
                        android:id="@+id/tvModSize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/badge_size_background"
                        android:paddingStart="7dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="7dp"
                        android:paddingBottom="2dp"
                        android:text="💾 0.5 MB"
                        android:textColor="#CBD5E1"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <!-- 60 FPS Locked Badge -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/badge_size_background"
                        android:paddingStart="6dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="2dp"
                        android:text="⚡ 60 FPS"
                        android:textColor="@color/omnitrix_glow"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <!-- Favorite Star Button -->
            <TextView
                android:id="@+id/btnFavorite"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/badge_size_background"
                android:gravity="center"
                android:text="☆"
                android:textColor="#FDE047"
                android:textSize="20sp" />

        </LinearLayout>

        <!-- Description -->
        <TextView
            android:id="@+id/tvModDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="3.5dp"
            android:text="Part 5 Living World Masterpiece! Autonomous villagers think and survive like real players: 4 Faith Pantheons, Sacred Altar Worship, Full Armor Suits, and Redstone Automations!"
            android:textColor="@color/text_gray"
            android:textSize="12.5sp" />

        <!-- Card Progress Bar (Visible during import) -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/cardProgress"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="10dp"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/omnitrix_green"
            app:trackColor="@color/surface_dark" />

        <!-- Action Row: Guide + Import -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnModDetails"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="📖 Guide"
                android:textColor="@color/omnitrix_glow"
                android:textSize="12sp"
                android:textStyle="bold"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1.2dp" />

            <Button
                android:id="@+id/btnImportMod"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/btn_civilization_emerald"
                android:elevation="4dp"
                android:text="🏛️ IMPORT CIVILIZATION ADDON 🏛️"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
