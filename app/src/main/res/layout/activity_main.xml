<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical">

    <!-- ========================================================================= -->
    <!-- TOP APP BAR -->
    <!-- ========================================================================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_dark"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:src="@drawable/app_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:text="BEDROCK MOD HUB"
                android:textColor="@color/text_white"
                android:textSize="16.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvMinecraftStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="🟢 Checking Minecraft..."
                    android:textColor="@color/omnitrix_glow"
                    android:textSize="11.5sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:text="•"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_size_background"
                    android:ellipsize="none"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:paddingStart="6dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="2dp"
                    android:singleLine="true"
                    android:text="v1.0.106 PRO"
                    android:textColor="@color/omnitrix_glow"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <!-- Quick Launch Minecraft Button -->
        <Button
            android:id="@+id/btnQuickLaunchMc"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:background="@drawable/btn_header_mc"
            android:elevation="4dp"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="🎮 Open MC"
            android:textColor="#042F2E"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

    </LinearLayout>

    <!-- Global Progress Bar for background tasks -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/mainProgressBar"
        android:layout_width="match_parent"
        android:layout_height="3.5dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/omnitrix_green"
        app:trackColor="@color/surface_dark" />

    <!-- ========================================================================= -->
    <!-- SEARCH BAR -->
    <!-- ========================================================================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="2dp">

        <!-- Modern Stadium Search Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/search_box_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="🔍"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@null"
                android:gravity="center_vertical"
                android:hint="Search mods (Cobblemon, Mythos, Guns)..."
                android:imeOptions="actionSearch"
                android:includeFontPadding="false"
                android:inputType="text"
                android:maxLines="1"
                android:padding="0dp"
                android:textColor="@color/text_white"
                android:textColorHint="@color/text_muted"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/btnClearSearch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                android:padding="8dp"
                android:text="✖"
                android:textColor="@color/text_muted"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Category Horizontal Filter Tabs -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupCategories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="8dp"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:minHeight="36dp"
                android:text="🌟 All"
                android:textColor="@color/text_white"
                app:chipBackgroundColor="@color/card_dark"
                app:chipStrokeColor="@color/card_stroke"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFavorites"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:text="⭐ Starred"
                android:textColor="#FDE047"
                app:chipBackgroundColor="@color/card_dark"
                app:chipStrokeColor="#CA8A04"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCustom"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:text="✨ My Mods (0)"
                android:textColor="#34D399"
                app:chipBackgroundColor="@color/card_dark"
                app:chipStrokeColor="#059669"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMythos"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:text="🔮 Mythos &amp; HD (2)"
                android:textColor="@color/text_white"
                app:chipBackgroundColor="@color/card_dark"
                app:chipStrokeColor="@color/card_stroke"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipBen10"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:text="👽 Ben 10 (2)"
                android:textColor="@color/text_white"
                app:chipBackgroundColor="@color/card_dark"
                app:chipStrokeColor="@color/card_stroke"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAnime"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:text="🎌 Anime &amp; Pokemon (6)"
                android:textColor="@color/text_white"
                app:chipBackgroundColor="@color/card_dark"
                app:chipStrokeColor="@color/card_stroke"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSuperhero"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:text="🦸 Superheroes (3)"
                android:textColor="@color/text_white"
                app:chipBackgroundColor="@color/card_dark"
                app:chipStrokeColor="@color/card_stroke"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAction"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:text="⚔️ Action &amp; Guns (3)"
                android:textColor="@color/text_white"
                app:chipBackgroundColor="@color/card_dark"
                app:chipStrokeColor="@color/card_stroke"
                app:chipStrokeWidth="1dp" />

        </com.google.android.material.chip.ChipGroup>

    </HorizontalScrollView>

    <!-- Result Count & Sort Mode Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvResultCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:text="Showing 16 Mods Available"
            android:textColor="@color/text_gray"
            android:textSize="12sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnSortMode"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/badge_size_background"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="11dp"
            android:paddingTop="4dp"
            android:paddingEnd="11dp"
            android:paddingBottom="4dp"
            android:text="⚡ Sort: Featured ▼"
            android:textColor="@color/omnitrix_glow"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ========================================================================= -->
    <!-- CONTENT AREA: RECYCLERVIEW + FLOATING ADD BUTTON -->
    <!-- ========================================================================= -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMods"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingTop="6dp"
            android:paddingBottom="76dp" />

        <!-- Empty search state -->
        <TextView
            android:id="@+id/tvEmptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:padding="24dp"
            android:text="🔍 No mods match your search.\nTap '➕ Add Mod' to add your own, or switch category."
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Floating Action Button: Add Custom Mod -->
        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fabAddMod"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="6dp"
            android:gravity="center"
            android:text="➕ Add Mod"
            android:textColor="#042F2E"
            android:textSize="12.5sp"
            android:textStyle="bold"
            app:backgroundTint="@color/omnitrix_green" />

    </FrameLayout>

    <!-- ========================================================================= -->
    <!-- BOTTOM FOOTER TOOLS & STATUS -->
    <!-- ========================================================================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_dark"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tvBottomInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:singleLine="true"
            android:text="💡 Tap 'Import' -> Minecraft opens &amp; installs automatically!"
            android:textColor="@color/text_gray"
            android:textSize="11.5sp" />

        <!-- Setup Guide Button -->
        <Button
            android:id="@+id/btnQuickGuide"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:background="@drawable/btn_footer_tool"
            android:gravity="center"
            android:paddingStart="11dp"
            android:paddingEnd="11dp"
            android:text="📖 Guide"
            android:textColor="@color/omnitrix_glow"
            android:textSize="11sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <!-- Clear Cache Button -->
        <Button
            android:id="@+id/btnClearCache"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:background="@drawable/btn_footer_tool"
            android:gravity="center"
            android:paddingStart="11dp"
            android:paddingEnd="11dp"
            android:text="🧹 Clean Cache"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            app:backgroundTint="@null" />

    </LinearLayout>

</LinearLayout>
