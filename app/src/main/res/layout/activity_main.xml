<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical">

    <!-- ========================================================================= -->
    <!-- TOP APP BAR -->
    <!-- ========================================================================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_dark"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/app_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BEDROCK MOD HUB"
                    android:textColor="@color/text_white"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/badge_size_background"
                    android:paddingStart="7dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="7dp"
                    android:paddingBottom="2dp"
                    android:text="v1.0.88 PRO"
                    android:textColor="@color/omnitrix_glow"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvMinecraftStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="🟢 Checking Minecraft..."
                android:textColor="@color/omnitrix_glow"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- Quick Launch Minecraft Button -->
        <Button
            android:id="@+id/btnQuickLaunchMc"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/btn_header_mc"
            android:elevation="4dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="🎮 Launch MC"
            android:textColor="#042F2E"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

    </LinearLayout>

    <!-- Global Progress Bar for background tasks -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/mainProgressBar"
        android:layout_width="match_parent"
        android:layout_height="3.5dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/omnitrix_green"
        app:trackColor="@color/surface_dark" />

    <!-- ========================================================================= -->
    <!-- SEARCH & CATEGORY BAR -->
    <!-- ========================================================================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="4dp">

        <!-- Modern Stadium Search Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/search_box_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Search 14 mods (Vehicles, Civilization, Ben 10, Solo Leveling)..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/text_white"
                android:textColorHint="@color/text_muted"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/btnClearSearch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="✖"
                android:textColor="@color/text_muted"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Category Horizontal Filter Tabs -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:overScrollMode="never"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupCategories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAll"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="🌟 All (14)"
                    android:textColor="@color/text_white"
                    app:chipBackgroundColor="@color/card_dark"
                    app:chipStrokeColor="@color/card_stroke"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFavorites"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⭐ Starred (0)"
                    android:textColor="#FDE047"
                    app:chipBackgroundColor="@color/card_dark"
                    app:chipStrokeColor="#CA8A04"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCiv"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏛️ Civilization &amp; HD (2)"
                    android:textColor="@color/text_white"
                    app:chipBackgroundColor="@color/card_dark"
                    app:chipStrokeColor="@color/card_stroke"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipVehicles"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏎️ Vehicles (1)"
                    android:textColor="@color/text_white"
                    app:chipBackgroundColor="@color/card_dark"
                    app:chipStrokeColor="@color/card_stroke"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBen10"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👽 Ben 10 (2)"
                    android:textColor="@color/text_white"
                    app:chipBackgroundColor="@color/card_dark"
                    app:chipStrokeColor="@color/card_stroke"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAnime"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎌 Anime Legends (4)"
                    android:textColor="@color/text_white"
                    app:chipBackgroundColor="@color/card_dark"
                    app:chipStrokeColor="@color/card_stroke"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSuperhero"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🦸 Superheroes (3)"
                    android:textColor="@color/text_white"
                    app:chipBackgroundColor="@color/card_dark"
                    app:chipStrokeColor="@color/card_stroke"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAction"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚔️ Action &amp; Guns (2)"
                    android:textColor="@color/text_white"
                    app:chipBackgroundColor="@color/card_dark"
                    app:chipStrokeColor="@color/card_stroke"
                    app:chipStrokeWidth="1dp" />

            </com.google.android.material.chip.ChipGroup>

        </HorizontalScrollView>

        <!-- Result Count & Spotlight Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvResultCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Showing 14 Mods Available"
                android:textColor="@color/text_gray"
                android:textSize="11.5sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnSortMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_size_background"
                android:paddingStart="9dp"
                android:paddingTop="3dp"
                android:paddingEnd="9dp"
                android:paddingBottom="3dp"
                android:text="⚡ Sort: Featured ▼"
                android:textColor="@color/omnitrix_glow"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- Empty search state -->
    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:text="😕 No mods match your search."
        android:textColor="@color/text_muted"
        android:textSize="15sp"
        android:visibility="gone" />

    <!-- ========================================================================= -->
    <!-- RECYCLERVIEW: 13 MOD CARDS (60 FPS SMOOTH SCROLL) -->
    <!-- ========================================================================= -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMods"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingTop="6dp"
        android:paddingBottom="12dp" />

    <!-- ========================================================================= -->
    <!-- BOTTOM FOOTER TOOLS & STATUS -->
    <!-- ========================================================================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_dark"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvBottomInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="💡 Pro Tip: Turn ON 'Beta APIs' in World Settings!"
            android:textColor="@color/text_gray"
            android:textSize="11sp" />

        <!-- Setup Guide Button -->
        <Button
            android:id="@+id/btnQuickGuide"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="📖 Setup Guide"
            android:textColor="@color/omnitrix_glow"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Clear Cache Button -->
        <Button
            android:id="@+id/btnClearCache"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="🧹 Clean Cache"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

    </LinearLayout>

</LinearLayout>
