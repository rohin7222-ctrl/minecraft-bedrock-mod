<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#DDD6FE">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#4C1D95"
                android:centerColor="#6D28D9"
