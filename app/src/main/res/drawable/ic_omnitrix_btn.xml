<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/omnitrix_glow">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:endColor="@color/omnitrix_green"
                android:startColor="@color/omnitrix_green_dark" />
            <corners android:radius="28dp" />
            <stroke
                android:width="2dp"
                android:color="@color/omnitrix_glow" />
        </shape>
    </item>
</ripple>

